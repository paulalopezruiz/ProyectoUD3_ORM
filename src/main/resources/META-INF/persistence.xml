<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="default">
        <class>org.example.models.Gestion</class>
        <class>org.example.models.Pieza</class>
        <class>org.example.models.Proveedor</class>
        <class>org.example.models.Proyecto</class>
        <class>org.example.models.Usuario</class>
        <class>org.example.models.RegistroAcceso</class>
        <class>org.example.models.RegistroAuditoria</class>

        <properties>
            <property name="hibernate.connection.driver_class"
                      value="org.mariadb.jdbc.Driver"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MariaDBDialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>